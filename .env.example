# Copy this file to ".env" in the project root, then fill in your private values.
# NEVER commit ".env" or share its contents.

PORT=3000
NODE_ENV=development

# Generate a long, random value for local session security.
SESSION_SECRET=replace-with-a-long-random-secret

# Admin bootstrap credentials (used only when initializing a fresh database).
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

MAX_BATCH_WORKERS=100

# Paystack Test Secret Key only (starts with sk_test_).
# Keep this server-side. Do not use or share a live secret key.
PAYSTACK_SECRET_KEY=
